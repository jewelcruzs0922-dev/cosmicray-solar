# Formspree form IDs
NEXT_PUBLIC_FORMSPREE_CONTACT_ID=your_contact_form_id
NEXT_PUBLIC_FORMSPREE_NEWSLETTER_ID=your_newsletter_form_id

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Tawk.to (optional)
NEXT_PUBLIC_TAWK_PROPERTY_ID=your_property_id
NEXT_PUBLIC_TAWK_WIDGET_ID=your_widget_id

# Sentry Error Monitoring (optional)
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# Feature Flags (optional)
NEXT_PUBLIC_FLAG_NEW_CHECKOUT=false
NEXT_PUBLIC_FLAG_NEWSLETTER_POPUP=false
NEXT_PUBLIC_FLAG_DARK_MODE=false
NEXT_PUBLIC_FLAG_AI_CHAT=false
NEXT_PUBLIC_FLAG_LIVE_PRICING=false
